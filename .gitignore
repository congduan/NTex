# 构建产物
/target
**/*.rs.bk

# macOS
.DS_Store

# TRIP/ETRIP fixtures（由 scripts/fetch-trip-fixtures.sh 获取）
fixtures/trip/
fixtures/etrip/

# 编译临时文件
/trip.*
*.aux
*.log
*.out
*.toc

# 测试/调试临时产物
tmp-*.tex
tmp-*.dvi
tmp-*.pdf
/ntex-out.dvi
/dec-ntex.txt
/dec-tex.txt
gluesim*.py
dvicmp2.py
dviprint.py
tmp_pngcmp.py

# 引擎本地构建产物（站点素材在 site/public/ 内另行跟踪）
# 注：ntex-dvi / ntex-backend 的输出落在**输入文件旁**——示例样张已迁 samples/，
# 故派生物随样本走（*.aux / *.log / *.out 已由上方全局规则覆盖）
samples/*.dvi
samples/*.png

# TRIP/ETRIP 运行产物
/tr
/tripos
/etrip.out
/etrip.fmt
/trip.fmt
/texput.out
/par_ended.dvi

# ETRIP/数学调试产物
/delim*.dvi
/mt2.pdf
/mu1*.pdf
/revision-test.dvi

# resume1 现场复现产物（源与 driver 入库 samples/，DVI/PDF 为派生件，随 samples/ 规则忽略）

# 备料字体暂存（环境只读主目录；正式入库字体经 make fixtures 流程）
/.local-fonts/
/demo-multi.*

# WASM 绑定生成物（wasm-bindgen CLI 产物，见 crates/ntex-wasm/README.md「构建」）
crates/ntex-wasm/www/pkg/
crates/ntex-wasm/examples/*.dvi
crates/ntex-tauri/ui/pkg/


.workbuddy
.zcode
8terminal
# Tauri 构建生成物（gen/schemas 由 tauri build 生成）
crates/ntex-tauri/gen/
.hermes/
__pycache__/
tests/semantic/work/
tests/semantic/cases/*.dvi
*.pdf

# 复现对照证据 PDF —— 上方 *.pdf 全局忽略的例外（证据类产物入库，
# 见 fixtures/repro/README.md「证据产物」节）
!fixtures/repro/pdf/*.pdf
