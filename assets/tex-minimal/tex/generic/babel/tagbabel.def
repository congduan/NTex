\ifx\bbl@chfmt\@undefined\else
  \EditInstance{heading}{chapter}{%
    prefix = ,
    number-format = \unskip\bbl@chfmt
   }
\fi
\ifx\bbl@partformat\@undefined\else
  \EditInstance{heading}{part}{%
    prefix = ,
    number-format = \unskip\bbl@partformat
   }
\fi
\@ifpackagewith{babel}{babel-metadata=tagging}{}{\endinput}
\let\bbl@ifmetadata\IfDocumentMetadataT
\ExplSyntaxOn
\NewTaggingSocket{babel/foreign/begin}{0}
\NewTaggingSocket{babel/foreign/end}{0}
\NewTaggingSocketPlug{babel/foreign/begin}{default}{
  \tag_mc_end_push:
  % \bbl@array@get\bbl@select@opts{raw}\bbl@tempa
  % \ifx\bbl@tempa\relax\let\bbl@tempa\@empty\fi
  \bbl@array@get\bbl@select@opts{actualtext}\bbl@tempb
  \ifx\bbl@tempb\relax\let\bbl@tempb\@empty\fi
  \tagstructbegin{tag=Span, lang=\BCPdata{tag},
     % raw=\bbl@tempa,
     actualtext=\bbl@tempb}
  \tagmcbegin {} }
\NewTaggingSocketPlug{babel/foreign/end}{default}{
  \tagmcend
  \tagstructend
  \tag_mc_begin_pop:n {}}
\AssignTaggingSocketPlug{babel/foreign/begin}{default}
\AssignTaggingSocketPlug{babel/foreign/end}{default}
\ExplSyntaxOff
\endinput
